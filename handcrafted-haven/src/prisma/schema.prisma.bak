generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(CUSTOMER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sellerProfile   Seller?
  customerProfile Customer?

  @@map("user") // maps to lowercase PostgreSQL table
}

model Seller {
  id        String   @id @default(cuid())
  shopName  String
  bio       String?
  logo      String?
  banner    String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  products  Product[]
  createdAt DateTime @default(now())

  @@map("seller")
}

model Customer {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  address   String?
  createdAt DateTime @default(now())

  @@map("customer")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Float
  description String?
  image       String?
  category    String?
  seller      Seller   @relation(fields: [sellerId], references: [id])
  sellerId    String
  createdAt   DateTime @default(now())

  @@map("product")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}
