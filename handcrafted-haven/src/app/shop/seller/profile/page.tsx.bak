// src/app/shop/seller/profile/page.tsx
'use client';

import React, { useState, useEffect } from "react";
import dynamic from "next/dynamic";
import Image from "next/image";
import { getSellerInfo } from "@/app/lib/data";
import WithAuth from "@/app/components/withAuth";
import type { ComponentType } from "react";

// Dynamically import UI components to prevent SSR errors — ensure we return the default export as a ComponentType
const Header = dynamic(
  () => import("@/app/ui/landing-page/header").then((mod) => mod.default as ComponentType<any>),
  { ssr: false }
);

const Footer = dynamic(
  () => import("@/app/ui/footer").then((mod) => mod.default as ComponentType<any>),
  { ssr: false }
);

const CallToAction = dynamic(
  () => import("@/app/ui/landing-page/cta-section").then((mod) => mod.default as ComponentType<any>),
  { ssr: false }
);

// --- rest of the file unchanged ---
function SellerProfilePageContent() {
  const [seller, setSeller] = useState({
    name: "",
    logo: "",
    banner: "",
    bio: "",
  });
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function loadSeller() {
      try {
        // Replace with logged-in seller ID from token/cookie in production
        const info = await getSellerInfo("seller1");
        setSeller(info);
      } catch (err) {
        console.error("Failed to load seller info:", err);
      } finally {
        setLoading(false);
      }
    }
    loadSeller();
  }, []);

  if (loading) return <p className="text-center mt-10">Loading profile...</p>;

  return (
    <div>
      <Header />

      <div className="max-w-5xl mx-auto p-6">
        <h1 className="text-3xl font-bold mb-6 text-center">My Profile</h1>

        <div className="relative w-full h-60 rounded-lg overflow-hidden mb-6">
          {seller.banner ? (
            <Image
              src={seller.banner}
              alt={`${seller.name} banner`}
              fill
              className="object-cover"
            />
          ) : (
            <div className="bg-gray-200 h-full flex items-center justify-center text-gray-500">
              No banner uploaded
            </div>
          )}
        </div>

        <div className="flex flex-col sm:flex-row gap-6 items-center">
          {seller.logo ? (
            <Image
              src={seller.logo}
              alt={`${seller.name} logo`}
              width={120}
              height={120}
              className="rounded-full border shadow object-cover"
            />
          ) : (
            <div className="w-[120px] h-[120px] flex items-center justify-center bg-gray-200 rounded-full border">
              No Logo
            </div>
          )}

          <div className="flex-1">
            <h2 className="text-2xl font-semibold mb-2">{seller.name || "Unnamed Seller"}</h2>
            <p className="text-gray-600 mb-4">
              {seller.bio || "No bio provided yet."}
            </p>

            <button
              className="px-4 py-2 bg-orange-500 text-white rounded hover:bg-orange-600 transition"
              onClick={() => alert("Edit Profile feature coming soon")}
            >
              Edit Profile
            </button>
          </div>
        </div>
      </div>

      <CallToAction />
      <Footer />
    </div>
  );
}

export default function ProtectedSellerProfilePage() {
  return (
    <WithAuth role="SELLER">
      <SellerProfilePageContent />
    </WithAuth>
  );
}
